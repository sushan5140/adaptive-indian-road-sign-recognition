# Leave-one-class-out working files: verbose training log and the
# intermediate manifests/checkpoints for each retrained holdout model.
# The measured results under outputs/loco_results/*.json and
# *_predictions.csv are committed; these are regenerable scratch.
outputs/loco_results/run.log
outputs/loco_work/

# Human-review image bundles and contact sheets are regenerable from the
# scripts plus the source dataset, and are large. Consistent with the existing
# outputs/v2_review/contact_sheets rule above.
outputs/v2_review/remaining_contact_sheets/
outputs/v2_review/remaining_review_bundle.pdf
outputs/open_set_acquisition/*_bundle.pdf
outputs/open_set_acquisition/*_pack_*.pdf

# V3 supplement experiment working files: retrained checkpoints and the
# regenerable merged manifest. Measured results under outputs/v3_results/
# are committed.
outputs/v3_work/

# V4 augmentation experiment working files: retrained checkpoints and log.
# Measured results under outputs/v4_results/ are committed.
outputs/v4_work/

# V5 ensemble experiment working files: five fold checkpoints, per-fold
# manifests and the log. Measured results under outputs/v5_results/ are
# committed.
outputs/v5_work/
